DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# admin login (one shared account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# demo: open /admin/* without logging in (ignored unless DEBUG=true)
ADMIN_AUTH_DISABLED=false

# Postgres + pgvector (docker compose)
POSTGRES_USER=hackyeah
POSTGRES_PASSWORD=hackyeah
POSTGRES_DB=hackyeah
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hackyeah:hackyeah@localhost:5432/hackyeah

# RabbitMQ (docker compose); management ui on http://localhost:15672
RABBITMQ_USER=hackyeah
RABBITMQ_PASSWORD=hackyeah
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://hackyeah:hackyeah@localhost:5672/

# innovation pdf upload: kept on disk, embedded by the rag service
RAG_URL=http://localhost:8001
UPLOAD_DIR=./data/uploads

# email notifications (mailpit in docker compose: web ui on http://localhost:8025); empty SMTP_HOST or MAIL_FROM = off. no placeholder addresses
SMTP_HOST=
SMTP_PORT=1025
# real relay, e.g. gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, an app password (never commit it)
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# testing: every notification goes here, author emails are ignored
MAIL_REDIRECT_TO=
WEB_URL=http://localhost:3000
# this api as seen from a browser (rating links in tester mails)
API_URL=http://localhost:8000
