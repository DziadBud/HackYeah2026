DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# admin login (one shared account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# demo: open /admin/* without logging in (ignored unless DEBUG=true)
ADMIN_AUTH_DISABLED=false

# Postgres + pgvector (docker compose)
POSTGRES_USER=hackyeah
POSTGRES_PASSWORD=hackyeah
POSTGRES_DB=hackyeah
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hackyeah:hackyeah@localhost:5432/hackyeah

# notifications (gmail: smtp.gmail.com:587 with an app password, not the account password)
# without SMTP_HOST mails are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# testing: every mail goes only to this address; keep it set until real recipients are wanted
MAIL_REDIRECT_TO=
WEB_URL=http://localhost:3000

# Google Gemini (LLM explanations / classification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# RabbitMQ (docker compose); management ui on http://localhost:15672
RABBITMQ_USER=hackyeah
RABBITMQ_PASSWORD=hackyeah
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://hackyeah:hackyeah@localhost:5672/

# innovation pdf upload: kept on disk, embedded by the rag service
RAG_URL=http://localhost:8001
UPLOAD_DIR=./data/uploads
